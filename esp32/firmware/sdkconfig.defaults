CONFIG_IDF_TARGET="esp32s3"

# Native USB-Serial/JTAG for console and flashing -- this board has no
# separate UART bridge, and UART1 is committed to the FPGA link.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Latency, not throughput, is what matters here.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16

# 240 MHz: the radio path is the bottleneck, so do not add to it.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 8 MB octal PSRAM present on this module.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
